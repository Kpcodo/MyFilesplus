<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State: Scale down and lower elevation -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator 
                android:propertyName="scaleX"
                android:valueTo="0.92" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="scaleY"
                android:valueTo="0.92" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="translationZ"
                android:valueTo="2dp" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="elevation"
                android:valueTo="2dp" 
                android:duration="100" />
        </set>
    </item>
    <!-- Default State: Normal scale and elevated -->
    <item>
        <set>
            <objectAnimator 
                android:propertyName="scaleX"
                android:valueTo="1.0" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="scaleY"
                android:valueTo="1.0" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="translationZ"
                android:valueTo="8dp" 
                android:duration="100" />
            <objectAnimator 
                android:propertyName="elevation"
                android:valueTo="8dp" 
                android:duration="100" />
        </set>
    </item>
</selector>
