<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/forecast_text_primary_adaptive"
        app:title="Storage Health"
        app:titleTextColor="@color/forecast_text_primary_adaptive" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- Storage Projection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/layout_smart_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/text_projection_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Forecast"
                            android:textColor="@color/forecast_text_primary_adaptive"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-medium" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            app:cardBackgroundColor="#3D5AFE"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="AI POWERED"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-black" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.mfp.filemanager.ui.views.LineChartView
                        android:id="@+id/chart_projection"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_smart_header" />

                    <TextView
                        android:id="@+id/text_total_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: 106.22 GB"
                        android:textColor="@color/forecast_text_secondary_adaptive"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/layout_smart_header"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/layout_smart_header" />

                    <TextView
                        android:id="@+id/text_now_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now: 99.68 GB"
                        android:textColor="@color/forecast_text_secondary_adaptive"
                        android:textSize="14sp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/chart_projection" />

                    <TextView
                        android:id="@+id/text_full_prediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Full by Feb 26, 2026"
                        android:textColor="@color/forecast_text_primary_adaptive"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_now_usage" />

                    <TextView
                        android:id="@+id/text_daily_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="You're using about 207.17 MB per day."
                        android:textColor="@color/forecast_text_secondary_adaptive"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_full_prediction" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="FILE TYPE DISTRIBUTION"
                android:textColor="@color/forecast_text_secondary_adaptive"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium" />

            <!-- Multi-segment Progress Bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:id="@+id/layout_distribution_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    
                    <View android:id="@+id/bar_apps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.4" android:background="@color/category_apps"/>
                    <View android:id="@+id/bar_videos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.2" android:background="@color/category_videos"/>
                    <View android:id="@+id/bar_images" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.1" android:background="@color/category_images"/>
                    <View android:id="@+id/bar_docs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_docs"/>
                    <View android:id="@+id/bar_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_audio"/>
                    <View android:id="@+id/bar_others" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_others"/>
                    <View android:id="@+id/bar_free" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.15" android:background="@color/category_free"/>
                    
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid of categories -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_circle_24"
                            app:tint="@color/forecast_text_primary_adaptive" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Free Space"
                        android:textColor="@color/forecast_text_primary_adaptive"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_free_space_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6.54 GB / 106.22 GB"
                        android:textColor="@color/forecast_text_secondary_adaptive"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true">

                <!-- Apps & Data -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_apps" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_android_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Apps" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_apps_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="97.19 GB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_apps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.4" android:background="@color/category_apps" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.6" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Videos -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_videos" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_video_file_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Videos" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_videos_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="30.23 GB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_videos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.2" android:background="@color/category_videos" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Images -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_images" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_image_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Images" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_images_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="6.98 GB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_images" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.1" android:background="@color/category_images" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Documents -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_docs" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_insert_drive_file_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Documents" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_docs_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="269.31 MB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_docs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_docs" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Audio -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_audio" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_music_note_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Audio" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_audio_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="94.54 MB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_audio" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Others -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                             <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" app:cardBackgroundColor="@color/category_others" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_more_horiz_24" app:tint="@color/forecast_text_primary_adaptive" />
                             </com.google.android.material.card.MaterialCardView>
                             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Others" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/text_others_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:text="3.56 MB" android:textColor="@color/forecast_text_primary_adaptive" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/forecast_legend_track" android:orientation="horizontal">
                            <View android:id="@+id/line_others" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.05" android:background="@color/category_others" />
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
