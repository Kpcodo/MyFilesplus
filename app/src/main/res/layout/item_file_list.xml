<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/checkbox_select"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:button="@drawable/selector_checkbox_round"
            android:buttonTint="@color/selector_checkbox_tint"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="File Icon"
            android:src="@drawable/ic_folder_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="Documents" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Jan 01, 2026" />

                <TextView
                    android:id="@+id/text_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="12 items" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:src="@drawable/ic_more_vert_24"
            android:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:paddingTop="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/btn_copy"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_content_copy_24" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Copy" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_move"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_move_to_24" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Move" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_share"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_share_24" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_rename"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_edit_24" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Rename" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_info"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_info_24" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Info" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_delete"
            style="@style/FileActionButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                style="@style/FileActionButtonIconStyle"
                android:src="@drawable/ic_delete"
                android:tint="#FF5252" />
            <TextView
                style="@style/FileActionButtonTextStyle"
                android:text="Delete"
                android:textColor="#FF5252" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
