<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:animateLayoutChanges="true">

    <!-- Home Heading -->
    <TextView
        android:id="@+id/text_home_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search Bar (Permanent Top) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline"
        app:cardBackgroundColor="?android:attr/colorBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_home_heading">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btn_search_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                app:tint="?android:attr/textColorPrimary"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/img_search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_search_24"
                app:tint="?android:attr/textColorSecondary"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/input_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:hint="Search files..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_search_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:visibility="gone"
                app:tint="?android:attr/textColorSecondary"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btn_search_filter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_filter_list_24"
                android:visibility="gone"
                app:tint="?android:attr/textColorSecondary"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dashboard Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="120dp">

                <!-- Storage Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_storage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/text_storage_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/dashboard_highlight"
                            android:textSize="38sp"
                            android:maxLines="1"
                            android:lines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="24sp"
                            app:autoSizeMaxTextSize="38sp"
                            android:fontFamily="sans-serif-light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/text_storage_usage_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="8dp"
                            android:text="STORAGE USAGE"
                            android:textColor="@color/dashboard_secondary"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:lines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="8sp"
                            app:autoSizeMaxTextSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            app:layout_constraintEnd_toStartOf="@id/card_forecast"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/text_storage_percent"
                            app:layout_constraintTop_toTopOf="@id/text_storage_percent" />

                        <TextView
                            android:id="@+id/text_storage_usage_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="0 GB / 0 GB"
                            android:textColor="@color/dashboard_highlight"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:lines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/card_forecast"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="@id/text_storage_usage_label"
                            app:layout_constraintTop_toBottomOf="@id/text_storage_usage_label" />

                        <LinearLayout
                            android:id="@+id/card_forecast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_soft_button"
                            android:elevation="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintBottom_toBottomOf="@id/text_storage_usage_value"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/text_storage_usage_label">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_trending_up_24"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/text_forecast_prediction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Forecast"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:lines="1"
                                android:maxLines="1"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <!-- Multi-segment Progress Bar -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/container_progress"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="9dp"
                            app:cardElevation="0dp"
                            app:layout_constraintTop_toBottomOf="@id/text_storage_percent">
                            
                            <LinearLayout
                                android:id="@+id/layout_progress_segments"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">
                                
                                <View android:id="@+id/segment_videos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#4285F4"/>
                                <View android:id="@+id/segment_images" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#A042F4"/>
                                <View android:id="@+id/segment_apps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#34A853"/>
                                <View android:id="@+id/segment_docs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#F44336"/>
                                <View android:id="@+id/segment_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#00ACC1"/>
                                <View android:id="@+id/segment_others" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0" android:background="#FFAB91"/>
                                <View android:id="@+id/segment_free" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF"/>
                                
                            </LinearLayout>

                            <View
                                android:id="@+id/view_progress_mask"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#FFFFFF"
                                android:visibility="gone"/>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Legend -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@id/container_progress">
                            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                
                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#4285F4"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Videos" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>
                                
                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#A042F4"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Images" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>

                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#34A853"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Apps" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>

                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#F44336"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Docs" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                
                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#00ACC1"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1.2" android:text="Audio" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>
                                
                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#FFAB91"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1.2" android:text="Others" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>

                                <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/legend_dot" android:backgroundTint="#FFFFFF"/>
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1.6" android:text="Free Space" android:textColor="@color/dashboard_secondary" android:textSize="14sp"/>
                                
                                <!-- Empty view to align with top row properly if needed -->
                                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                            </LinearLayout>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- Recent Files Header -->
                <TextView
                    android:id="@+id/text_recent_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="RECENT FILES"
                    android:textColor="@color/dashboard_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintStart_toStartOf="@id/card_storage"
                    app:layout_constraintTop_toBottomOf="@id/card_storage" />

                <TextView
                    android:id="@+id/btn_view_recent_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="@color/dashboard_accent"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBaseline_toBaselineOf="@id/text_recent_header"
                    app:layout_constraintEnd_toEndOf="@id/card_storage" />

                <!-- Recent Files Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_recent_files"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:layout_constraintEnd_toEndOf="@id/card_storage"
                    app:layout_constraintStart_toStartOf="@id/card_storage"
                    app:layout_constraintTop_toBottomOf="@id/text_recent_header">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_recent_files"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recent_file" />
                        
                </com.google.android.material.card.MaterialCardView>
                    
                <!-- All Storage Header -->
                <TextView
                    android:id="@+id/text_all_storage_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="ALL STORAGE"
                    android:textColor="@color/dashboard_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintStart_toStartOf="@id/card_storage"
                    app:layout_constraintTop_toBottomOf="@id/card_recent_files" />

                <!-- Storage Options Row -->
                <LinearLayout
                    android:id="@+id/layout_storage_options"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="@id/card_storage"
                    app:layout_constraintStart_toStartOf="@id/card_storage"
                    app:layout_constraintTop_toBottomOf="@id/text_all_storage_header">

                    <!-- Internal Storage -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_browse_internal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_mobile_phone"
                                app:tint="@color/dashboard_card_icon_tint" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Internal"
                                    android:textColor="@color/dashboard_card_text"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Storage"
                                    android:textColor="@color/dashboard_card_text"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Other Storage -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_browse_other"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_sd_card"
                                app:tint="@color/dashboard_card_icon_tint" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Other"
                                    android:textColor="@color/dashboard_card_text"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Storage"
                                    android:textColor="@color/dashboard_card_text"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Blur Overlay (Behind Results, Over Dashboard) -->
    <View
        android:id="@+id/view_blur_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search" />

    <!-- Search Results (Overlay) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_search_results"
        android:visibility="gone"
        android:elevation="5dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_search"
        android:background="?android:attr/colorBackground"
        tools:visibility="visible"
        tools:listitem="@layout/item_file_list"/>

</androidx.constraintlayout.widget.ConstraintLayout>
