<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid fluid base: very translucent -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="#08FFFFFF" /> <!-- Extremely subtle fill -->
        </shape>
    </item>

    <!-- Glossy reflection (Diagonal) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#25FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>

    <!-- Soft Inner Glow -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <stroke android:width="1dp" android:color="#15FFFFFF" />
        </shape>
    </item>

    <!-- Outer Rim (Crisp edge) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <stroke android:width="0.5dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
