<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Outer Body -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>
    
    <!-- Sheen / Texture (Radial) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#333333"
                android:centerColor="#111111"
                android:endColor="#080808" />
        </shape>
    </item>

    <!-- === MAIN GROOVES (Stronger) === -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
             <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
             <stroke android:width="1dp" android:color="#282828" />
        </shape>
    </item>
    <item android:top="60dp" android:bottom="60dp" android:left="60dp" android:right="60dp">
        <shape android:shape="oval">
             <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>

    <!-- === SUBTLE GROOVES (Texture) === -->
    <!-- Outer -->
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
    <item android:top="30dp" android:bottom="30dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
    <item android:top="50dp" android:bottom="50dp" android:left="50dp" android:right="50dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
    <item android:top="70dp" android:bottom="70dp" android:left="70dp" android:right="70dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>
    <item android:top="75dp" android:bottom="75dp" android:left="75dp" android:right="75dp">
        <shape android:shape="oval">
             <stroke android:width="0.5dp" android:color="#1F1F1F" />
        </shape>
    </item>

    <!-- The area beyond 84dp is covered by the album art card in logic, so we stop here -->
</layer-list>
