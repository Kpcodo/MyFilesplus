<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid-like gradient for depth -->
    <gradient
        android:startColor="@color/glass_gradient_start"
        android:centerColor="@color/glass_gradient_center"
        android:endColor="@color/glass_gradient_end"
        android:angle="45"
        android:type="linear" />
    
    <corners android:radius="100dp" />
    
    <!-- Sophisticated liquid edge -->
    <stroke
        android:width="1.5dp"
        android:color="@color/glass_taskbar_stroke" />
</shape>
